                  "const getRoleRequest = {",
                  "    url: pm.environment.get('keycloak_url') + '/admin/realms/' + pm.environment.get('realm') + '/roles/user',",
                  "    method: 'GET',",
                  "    header: {",
                  "        'Authorization': 'Bearer ' + pm.environment.get('admin_token')",
                  "    }",
                  "};",
                  "",
                  "pm.sendRequest(getRoleRequest, function (err, response) {",
                  "    if (!err && response.code === 200) {",
                  "        const roleData = response.json();",
                  "        const requestBody = [",
                  "            {",
                  "                'id': roleData.id,",
                  "                'name': roleData.name",
                  "            }",
                  "        ];",
                  "        pm.request.body.raw = JSON.stringify(requestBody);",
                  "    }",
                  "});"
                ]
