                  "        },",
                  "        body: {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify({",
                  "                username: 'role-test-user-' + new Date().getTime(),",
                  "                email: 'role-test-' + new Date().getTime() + '@example.com',",
                  "                firstName: 'Role',",
                  "                lastName: 'Test',",
                  "                enabled: true,",
                  "                emailVerified: false,",
                  "                password: 'TestPass123!',",
